# Copy to .env for local development: the server reads it when NODE_ENV is not production.
# Production takes these from the host's environment settings. Never commit real values.

# PostgreSQL for profiles, ratings and the leaderboard (server only). Unset: ranking is off.
# Local example: postgres://cb:<password>@127.0.0.1:54329/circuit_breaker
DATABASE_URL=

# TLS to the database: auto (from the URL's sslmode), require, no-verify or off.
DATABASE_SSL=auto

# Connections the server may hold.
DB_POOL_MAX=5

# auto: apply pending migrations at boot. off: run `npm run db:migrate` yourself.
DB_MIGRATE=auto

# Proxies in front of the server that set X-Forwarded-For/-Proto (Render, Railway: 1).
TRUST_PROXY=0

# Secure cookies: auto (when the browser came over HTTPS), 1 always, 0 never.
COOKIE_SECURE=auto

# A client served from another origin (credentialed CORS, cross-site cookie). Usually unset.
CORS_ORIGIN=

# Open Socket.IO connections in total, and from one address (behind a proxy, set TRUST_PROXY
# first, or every player shares the proxy's address). New connections per address are limited
# to this many at once and twice this many a minute.
MAX_CONNECTIONS=1000
MAX_CONNECTIONS_PER_IP=32

# Rooms the process holds at once.
MAX_ROOMS=500

# Logs: json (one object per line, the default in production) or text.
LOG_FORMAT=

# /metrics from another machine needs this as a bearer token (Authorization: Bearer ...).
# Unset: /metrics answers only requests made on the server's own machine.
METRICS_TOKEN=

# Tests only: a database the tests may create and drop throwaway schemas in.
# Must not be DATABASE_URL.
TEST_DATABASE_URL=
